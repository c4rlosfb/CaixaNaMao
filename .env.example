# =============================================================================
# CaixaNaMão — exemplo de variáveis de ambiente
# Copie para `.env` (não versionado) e ajuste os valores.
#     cp .env.example .env
# O docker-compose.yml exige POSTGRES_PASSWORD e JWT_SECRET.
# =============================================================================

# --- PostgreSQL (cluster único, databases lógicos — ADR-003) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=postgres

# --- Senhas dos usuários de serviço (consumidas pelo infra/init-db.sql) ---
PEDIDOS_DB_PASSWORD=pedidos_pass
ESTOQUE_DB_PASSWORD=estoque_pass
AUTH_DB_PASSWORD=auth_pass

# --- Autenticação JWT (ADR-001/§6) ---
JWT_SECRET=troque-este-segredo

# -----------------------------------------------------------------------------
# servico-estoque (gRPC :50051 / health :8002)
# A DATABASE_URL é montada pelo compose; em execução fora do compose, use:
#   postgresql+asyncpg://estoque_user:estoque_pass@localhost:5432/estoque_db
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
LOCK_TTL_SECONDS=5
GRPC_HOST=0.0.0.0
GRPC_PORT=50051
GRPC_MAX_CONCURRENT_RPCS=100
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8002
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# servico-pedidos (REST :8000)
# -----------------------------------------------------------------------------
ESTOQUE_GRPC_HOST=servico-estoque
ESTOQUE_GRPC_PORT=50051
AWS_ENDPOINT_URL=http://localstack:4566
AWS_DEFAULT_REGION=us-east-1
SQS_QUEUE_PEDIDOS=caixanamao-pedidos-criados
SQS_QUEUE_ESTOQUE=caixanamao-estoque-atualizado
