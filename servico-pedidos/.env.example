# =============================================================================
# servico-pedidos — variáveis de ambiente (REST :8000)
#
# Copie para `.env` na raiz do repositório (ou exporte no ambiente) e ajuste.
# NUNCA versione o `.env` — ele está no .gitignore.
# No docker-compose.yml estes valores já são injetados; este arquivo é a
# referência para rodar o serviço direto no host (dev).
# =============================================================================

# --- Banco de dados (pedidos_db — ADR-003) ---
# Driver assíncrono (asyncpg) é obrigatório: a aplicação usa SQLAlchemy async.
DATABASE_URL=postgresql+asyncpg://pedidos_user:pedidos_pass@localhost:5432/pedidos_db
# Pool de conexões (padrões de app/config.py)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Autenticação JWT (HS256 — mesmo segredo do servico-autenticacao) ---
# Em produção: obrigatório definir. Gere com: openssl rand -hex 32
JWT_SECRET=troque-em-producao-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256

# --- gRPC: servico-estoque (contrato shared-protos/estoque.proto) ---
ESTOQUE_GRPC_HOST=localhost
ESTOQUE_GRPC_PORT=50051

# --- AWS SQS (ADR-005) — LocalStack em dev ---
# A publicação é best-effort: se a fila não responder, o pedido continua sendo
# criado (o erro é logado, não bloqueia o 201).
AWS_ENDPOINT_URL=http://localhost:4566
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_QUEUE_PEDIDOS=caixanamao-pedidos-criados

# --- Observabilidade ---
LOG_LEVEL=INFO
